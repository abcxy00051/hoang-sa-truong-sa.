# ============================================================================
# TỆP MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Sao chép tệp này thành .env và điền Token thực tế của bạn vào tệp .env
# Tuyệt đối KHÔNG điền Token thật vào tệp .env.example này!
# ============================================================================

COZE_BOT_ID=7699128420429725701
COZE_API_BASE_URL=https://api.coze.com

# Điền Personal Access Token (bắt đầu bằng pat_...) vào file .env (KHÔNG điền ở đây)
COZE_API_TOKEN=

# Hoặc cấu hình OAuth JWT App để Backend tự động sinh Access Token ngắn hạn
COZE_OAUTH_CLIENT_ID=
COZE_OAUTH_PUBLIC_KEY_ID=
COZE_OAUTH_PRIVATE_KEY=
